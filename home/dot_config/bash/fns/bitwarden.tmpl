# Bitwarden CLI: SSH keys and GPG passphrases
if command -v bw &> /dev/null; then
  # Preset the passphrase of GPG key $2 from the "passphrase" field of item $1 in $items
  _bwu_gpg_preset() {
    local pass grip
    pass=$(jq -r --arg n "$1" 'first(.[] | select(.name == $n) | .fields[]? | select(.name == "passphrase") | .value) // empty' <<< "$items")
    [[ -n $pass ]] || return 1
    grip=$(gpg --no-auto-check-trustdb --list-secret-keys --with-colons --with-keygrip "$2" 2> /dev/null | awk -F: '$1 == "grp" { print $10; exit }')
    [[ -n $grip ]] || return 1
    printf '%s' "$pass" | "$(gpgconf --list-dirs libexecdir)/gpg-preset-passphrase" --preset "$grip"
  }

  # Unlock the vault, load SSH keys and GPG passphrases, then lock it again
  bwu() {
    local -x BW_SESSION=${BW_SESSION:-}
    local items key relock=0 ssh=0 gpg=0 ttl=12h

    if [[ -z $BW_SESSION ]] || ! bw unlock --check &> /dev/null; then
      if ! BW_SESSION=$(bw unlock --raw); then
        bw login --check &> /dev/null && return 1
        BW_SESSION=$(bw login --raw) || return 1
      fi
      relock=1
    fi

    if ! items=$(bw list items); then
      (( relock )) && bw lock > /dev/null
      return 1
    fi

    # Sync the local cache for the next run, then lock, in the background
    (( relock )) && ( (bw sync && bw lock) &> /dev/null & )

    while IFS= read -r key; do
      base64 -d <<< "$key" | ssh-add -q -t "$ttl" - && ssh=$((ssh + 1))
    done < <(jq -r '.[] | select(.type == 5) | .sshKey.privateKey | @base64' <<< "$items")
{{ range $name, $fpr := .gpg.keys }}
    _bwu_gpg_preset {{ $name }} {{ $fpr }} && gpg=$((gpg + 1))
{{- end }}

    if (( ssh == 0 )); then
      echo "bwu: no SSH keys in the vault" >&2
    else
      echo "bwu: $ssh SSH key(s) loaded for $ttl"
    fi
    echo "bwu: $gpg GPG passphrase(s) preset"
    (( ssh > 0 ))
  }

  # Lock the vault and clear the SSH agent and GPG passphrase cache
  bwl() {
    ssh-add -D &> /dev/null
    gpg-connect-agent reloadagent /bye > /dev/null
    bw lock > /dev/null
    unset BW_SESSION
    echo "bwl: vault locked, SSH agent and GPG cache cleared"
  }
fi

# Login shells: PATH and editor, then .bashrc

if [ -d "$HOME/.local/bin" ]; then
    PATH="$HOME/.local/bin:$PATH"
fi

# mise shims for login and graphical sessions
if [ -d "$HOME/.local/share/mise/shims" ]; then
    PATH="$HOME/.local/share/mise/shims:$PATH"
fi

export PATH

# Editor used by CLI and graphical apps
export EDITOR="nvim"
export SUDO_EDITOR="$EDITOR"

# if running bash, include .bashrc last so it sees the full PATH
if [ -n "$BASH_VERSION" ] && [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi

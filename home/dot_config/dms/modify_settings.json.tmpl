#!/usr/bin/env bash
# DuxShell rewrites settings.json on every change, so manage only the keys that differ from its defaults.
set -euo pipefail

current=$(cat)
[[ -n $current ]] || current='{}'

jq --arg theme {{ printf "%s/.config/dms/themes/rosePine/theme.json" .chezmoi.homeDir | quote }} '
    .currentThemeName = "custom"
    | .currentThemeCategory = "registry"
    | .customThemeFile = $theme
    | .registryThemeVariants.rosePine = "rosePine"
    | .radiusStrength = 38
    | .niriLayoutGapsOverride = 8
    | .niriLayoutRadiusOverride = 16
    | .clockFormat = "24h"
    | .barElevationEnabled = false
    | .blurWallpaperOnOverview = true
    | .launcherStyle = "spotlight"
    | .useAutoLocation = true
    | .networkPreference = "wifi"
    | .dashTabs = [
        {id: "overview", enabled: false},
        {id: "media", enabled: false},
        {id: "wallpaper", enabled: false},
        {id: "weather", enabled: false},
        {id: "settings", enabled: true},
        {id: "wellbeing", enabled: false},
        {id: "notifications", enabled: false}
    ]
    | .dashTabsEvenlySpaced = false
    | .dashOptions = {overview: {panelRows: 4}, weather: {city: true}}
    | .barConfigs = ((.barConfigs // [{
        id: "default",
        name: "Main Bar",
        enabled: true,
        position: 0,
        screenPreferences: ["all"],
        showOnLastDisplay: true
    }]) | map(if .id == "default" then . + {
        leftWidgets: [
            {
                id: "launcherButton",
                enabled: true,
                launcherLogoMode: "os",
                launcherLogoColorOverride: "primary",
                launcherLogoSizeOffset: 0
            },
            {
                id: "workspaceSwitcher",
                enabled: true,
                showWorkspaceIndex: true,
                workspaceIndicatorStyle: "pills",
                workspaceIndicatorCompact: false,
                workspaceIndicatorRoundness: -1
            },
            {id: "music", enabled: true}
        ],
        centerWidgets: ["clock", "weather"],
        rightWidgets: [
            {id: "systemTray", enabled: true},
            {id: "cpuUsage", enabled: true},
            {id: "memUsage", enabled: true},
            {id: "notificationButton", enabled: true},
            {id: "battery", enabled: true},
            {
                id: "controlCenterButton",
                enabled: true,
                showAudioPercent: false,
                showMicIcon: false,
                showMicPercent: false,
                showBatteryIcon: false
            }
        ]
    } else . end))
' <<<"$current" | head -c -1

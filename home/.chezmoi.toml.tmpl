{{- $name := promptStringOnce . "git.name" "Git name" "Luca Pattocchio" -}}
{{- $email := promptStringOnce . "git.email" "Default Git email" -}}
{{- $githubEmail := promptStringOnce . "git.github.email" "GitHub email" "15154851+Kasui92@users.noreply.github.com" -}}

[data.git]
    name = {{ $name | quote }}
    email = {{ $email | quote }}

[data.git.github]
    email = {{ $githubEmail | quote }}

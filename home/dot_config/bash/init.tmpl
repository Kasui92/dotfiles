{{- /* Only tools present at apply time are included; static init scripts are embedded to skip a process per shell */ -}}
{{- $mise := lookPath "mise" -}}
{{- if and (not $mise) (stat (joinPath .chezmoi.homeDir ".local/bin/mise")) -}}
{{-   $mise = joinPath .chezmoi.homeDir ".local/bin/mise" -}}
{{- end -}}
{{- if $mise -}}
# mise output depends on the current PATH, so it is evaluated at runtime
eval "$({{ $mise | quote }} activate bash)"
{{ end -}}

{{- if lookPath "starship" }}
if [[ $- == *i* ]] && [[ ${TERM:-} != "dumb" ]]; then
{{ output "starship" "init" "bash" | trim }}
fi
{{ end -}}

{{- if lookPath "zoxide" }}
{{ output "zoxide" "init" "bash" | trim }}
{{ end -}}

{{- if lookPath "fzf" }}
{{ output "fzf" "--bash" | trim }}
{{ end -}}

{{- if lookPath "tv" }}
{{ output "tv" "init" "bash" | trim }}
{{ end -}}

{{- $plugins := printf "%s/.config/zellij/plugins" .chezmoi.homeDir -}}
"{{ $plugins }}/zjstatus.wasm" {
    ReadApplicationState
    ChangeApplicationState
    RunCommands
}
"{{ $plugins }}/vim-zellij-navigator.wasm" {
    ReadApplicationState
    WriteToStdin
    ChangeApplicationState
}
"{{ $plugins }}/zellij-forgot.wasm" {
    ReadApplicationState
    ChangeApplicationState
}
"{{ $plugins }}/zellij-sessionizer.wasm" {
    ReadApplicationState
    ChangeApplicationState
    RunCommands
}

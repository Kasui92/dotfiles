{{- if lookPath "gnome-shell" -}}
#!/bin/sh
set -eu

{{ template "gnome-extensions.sh" . }}

required='{{ .gnome.extensions.mosaic }} {{ .gnome.extensions.spacebar }}'
conflicting='{{ .gnome.extensions.conflicting | join " " }}'

# Competing tilers are always disabled. Wait for the shell to tear them down:
# Tiling Assistant restores its mutter overrides on disable, and the keybindings
# script must run after that.
for uuid in $conflicting; do
  if ! ext_installed "$uuid"; then
    continue
  fi
  if ext_listed disabled-extensions "$uuid" && ! ext_listed enabled-extensions "$uuid"; then
    continue
  fi
  if shell_session; then
    gnome-extensions disable "$uuid"
    tries=0
    while gnome-extensions info "$uuid" | grep -q 'State: ACTIVE' && [ "$tries" -lt 25 ]; do
      sleep 0.2
      tries=$((tries + 1))
    done
  else
    ext_list_remove enabled-extensions "$uuid"
    ext_list_add disabled-extensions "$uuid"
  fi
  echo "Disabled GNOME extension $uuid"
done

if [ "$(gsettings get org.gnome.shell disable-user-extensions)" = true ]; then
  echo "warning: user extensions are disabled globally; skipping $required" >&2
  exit 0
fi

shell_major=$(gnome-shell --version | sed -n 's/^GNOME Shell \([0-9]*\).*/\1/p')

install_from_ego() {
  if ! info=$(curl -fsSL --get --data-urlencode "uuid=$1" \
    --data-urlencode "shell_version=$shell_major" \
    https://extensions.gnome.org/extension-info/); then
    echo "warning: $1 not found on extensions.gnome.org for GNOME $shell_major" >&2
    return 0
  fi
  url=$(printf '%s' "$info" | sed -n 's/.*"download_url": *"\([^"]*\)".*/\1/p')
  if [ -z "$url" ]; then
    echo "warning: no download for $1 on GNOME $shell_major" >&2
    return 0
  fi
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  curl -fsSL -o "$tmp/extension.zip" "https://extensions.gnome.org$url"
  gnome-extensions install --force "$tmp/extension.zip"
  ext_list_remove disabled-extensions "$1"
  ext_list_add enabled-extensions "$1"
  echo "Installed GNOME extension $1; log out and back in to load it"
}

for uuid in $required; do
  if ext_enabled "$uuid"; then
    continue
  fi
  if ext_installed "$uuid"; then
    if shell_session; then
      gnome-extensions enable "$uuid"
    else
      ext_list_remove disabled-extensions "$uuid"
      ext_list_add enabled-extensions "$uuid"
    fi
    echo "Enabled GNOME extension $uuid"
  elif shell_session; then
    # Shows GNOME's confirmation dialog, then installs and enables in place.
    result=$(gdbus call --session --timeout 300 \
      --dest org.gnome.Shell.Extensions \
      --object-path /org/gnome/Shell/Extensions \
      --method org.gnome.Shell.Extensions.InstallRemoteExtension "$uuid" 2>&1) || true
    case "$result" in
      *successful*) echo "Installed GNOME extension $uuid" ;;
      *) echo "warning: $uuid not installed: $result" >&2 ;;
    esac
  else
    install_from_ego "$uuid"
  fi
done
{{ end -}}

# See https://git-scm.com/docs/git-config

[user]
	name = {{ .git.name | quote }}
	email = {{ .git.email | quote }}

# Shared settings, split by area
[include]
    path = config-credentials
    path = config-aliases
    path = config-core
    path = config-ui

# GitHub
[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
    path = ~/.config/git/config-github

[includeIf "hasconfig:remote.*.url:https://github.com/**"]
    path = ~/.config/git/config-github

# GitLab
[includeIf "hasconfig:remote.*.url:git@gitlab.com:*/**"]
    path = ~/.config/git/config-gitlab

[includeIf "hasconfig:remote.*.url:https://gitlab.com/**"]
		path = ~/.config/git/config-gitlab

# Codeberg
[url "git@codeberg.org:"]
    insteadOf = https://codeberg.org/

[includeIf "hasconfig:remote.*.url:git@codeberg.org:*/**"]
    path = ~/.config/git/config-codeberg

[includeIf "hasconfig:remote.*.url:ssh://git@codeberg.org/**"]
    path = ~/.config/git/config-codeberg

[includeIf "hasconfig:remote.*.url:https://codeberg.org/**"]
		path = ~/.config/git/config-codeberg

# Machine-local configuration (intentionally unmanaged by chezmoi)
[include]
    path = ~/.config/git/config-local

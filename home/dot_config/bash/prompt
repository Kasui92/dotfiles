# Prompt configuration: segments are computed by __prompt before each prompt
force_color_prompt=yes
color_prompt=yes

# SSH user (e.g. ssh:(localuser@remotehost))
_ps_ssh=
if [[ -n $SSH_CLIENT || -n $SSH_TTY ]]; then
    _ps_ssh=$' \001\e[1;36m\002ssh:(\001\e[0;38;5;107m\002'"$USER@$HOSTNAME"$'\001\e[1;36m\002)\001\e[0m\002 '
fi

__prompt() {
    local status=$? out gitdir top head branch rel name len
    local -a parts

    # Git dir and work tree root in one call; inside .git only the dir is printed
    out=$(git rev-parse --absolute-git-dir --show-toplevel 2> /dev/null)
    gitdir=${out%%$'\n'*}
    top=
    [[ $out == *$'\n'* ]] && top=${out#*$'\n'}

    # Current branch, empty on detached HEAD
    _ps_git=
    if [[ -n $gitdir ]]; then
        head=
        { read -r head < "$gitdir/HEAD"; } 2> /dev/null
        branch=
        [[ $head == "ref: refs/heads/"* ]] && branch=${head#ref: refs/heads/}
        [[ $branch == .invalid ]] && branch=$(git symbolic-ref --short -q HEAD)
        [[ -n $branch ]] && _ps_git=$' \001\e[1;36m\002git:(\001\e[0;38;5;107m\002'"$branch"$'\001\e[1;36m\002)\001\e[0m\002'
    fi

    # Short PWD: repo name, ~ or absolute path, then the last two components
    if [[ -n $top ]]; then
        rel=${PWD#"$top"}
        rel=${rel#/}
        name=${top##*/}
        IFS=/ read -ra parts <<< "$rel"
        len=${#parts[@]}
        if [[ -z $rel ]]; then
            _ps_path=$name
        elif (( len <= 1 )); then
            _ps_path=$name/$rel
        else
            _ps_path=…/${parts[len-2]}/${parts[len-1]}
        fi
    elif [[ $PWD == "$HOME"* ]]; then
        rel=${PWD#"$HOME"}
        rel=${rel#/}
        IFS=/ read -ra parts <<< "$rel"
        len=${#parts[@]}
        if [[ -z $rel ]]; then
            _ps_path='~'
        elif (( len <= 2 )); then
            _ps_path=\~/$rel
        else
            _ps_path=…/${parts[len-2]}/${parts[len-1]}
        fi
    else
        IFS=/ read -ra parts <<< "$PWD"
        len=${#parts[@]}
        if (( len <= 2 )); then
            _ps_path=$PWD
        else
            _ps_path=…/${parts[len-2]}/${parts[len-1]}
        fi
    fi
    _ps_path=$'\001\e[31m\002'"$_ps_path"$'\001\e[0m\002'

    # Cursor, red cross after a failed command
    if (( status )); then
        _ps_cursor=$'\001\e[31m\002✗\001\e[0m\002 '
    else
        _ps_cursor=$'\001\e[31m\002❯\001\e[0m\002 '
    fi
}

PROMPT_COMMAND=__prompt
PS1='${_ps_ssh}${_ps_path}${_ps_git} ${_ps_cursor}'

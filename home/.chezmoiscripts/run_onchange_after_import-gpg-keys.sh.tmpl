{{- if dig "bitwarden" "enabled" false . -}}
{{- $installed := output "gpg" "--no-auto-check-trustdb" "--list-secret-keys" "--with-colons" -}}
{{- $missing := list -}}
{{- range $name, $fpr := .gpg.keys -}}
{{-   if not (contains $fpr $installed) -}}
{{-     $missing = append $missing (list $name $fpr) -}}
{{-   end -}}
{{- end -}}
#!/bin/bash
# Import GPG secret keys stored as Bitwarden secure notes (notes = armored secret key).
# Bitwarden is queried only for keys missing from the local keyring.
set -euo pipefail
{{- if $missing }}

if [[ -z ${BW_SESSION:-} ]] || ! bw unlock --check &> /dev/null; then
  if ! BW_SESSION=$(bw unlock --raw); then
    bw login --check &> /dev/null && exit 1
    BW_SESSION=$(bw login --raw)
  fi
  export BW_SESSION
  trap 'bw lock > /dev/null' EXIT
fi
bw sync > /dev/null
items=$(bw list items --search gpg-)
{{ range $missing }}
# {{ index . 0 }}
jq -r --arg n {{ index . 0 | quote }} 'first(.[] | select(.name == $n) | .notes) // empty' <<< "$items" | gpg --batch --import
echo "{{ index . 1 }}:6:" | gpg --import-ownertrust
{{ end }}
gpg --check-trustdb
{{- end }}
{{ end -}}

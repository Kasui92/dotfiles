// Locked-first: Ctrl g opens Normal as a leader menu, a letter picks the mode, every exit returns to Locked
keybinds clear-defaults=true {
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }
    normal {
        bind "p" { SwitchToMode "Pane"; }
        bind "n" { SwitchToMode "Resize"; }
        bind "s" { SwitchToMode "Scroll"; }
        bind "o" { SwitchToMode "Session"; }
    }
    resize {
        bind "h" "Left" { Resize "Left"; }
        bind "j" "Down" { Resize "Down"; }
        bind "k" "Up" { Resize "Up"; }
        bind "l" "Right" { Resize "Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }
    pane {
        bind "r" { NewPane "Right"; SwitchToMode "Locked"; }
        bind "Shift f" { ToggleFocusNoUiFullscreen; SwitchToMode "Locked"; }
        bind "z" { TogglePaneFrames; SwitchToMode "Locked"; }
        bind "c" { SwitchToMode "RenamePane"; PaneNameInput 0; }
    }
    scroll {
        bind "e" { EditScrollback; SwitchToMode "Locked"; }
        bind "s" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Locked"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "[" { ScrollToPreviousPrompt; }
        bind "]" { ScrollToNextPrompt; }
        bind "c" { CopyLastCommandOutput; SwitchToMode "Locked"; }
        // uncomment this and adjust key if using copy_on_select=false
        // bind "Alt c" { Copy; }
    }
    search {
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Locked"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "n" { Search "down"; }
        bind "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }
    // Text input modes: every other key is typed, so only Enter/Esc/Ctrl c are bound
    entersearch {
        bind "Ctrl c" "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }
    renametab {
        bind "Ctrl c" "Enter" { SwitchToMode "Locked"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Locked"; }
    }
    renamepane {
        bind "Ctrl c" "Enter" { SwitchToMode "Locked"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "Locked"; }
    }
    session {
        bind "d" { Detach; }
    }
    // Direct shortcuts, available in every mode including Locked: the letter picks the object, Shift the wider variant
    shared {
        // Focus across zellij panes and neovim splits (zellij-nav.nvim handles the nvim side), Shift moves the pane
        bind "Alt h" {
            MessagePlugin "vim-nav" { name "move_focus_or_tab"; payload "left"; move_mod "alt"; use_arrow_keys "false"; floating true; };
        }
        bind "Alt j" {
            MessagePlugin "vim-nav" { name "move_focus"; payload "down"; move_mod "alt"; use_arrow_keys "false"; floating true; };
        }
        bind "Alt k" {
            MessagePlugin "vim-nav" { name "move_focus"; payload "up"; move_mod "alt"; use_arrow_keys "false"; floating true; };
        }
        bind "Alt l" {
            MessagePlugin "vim-nav" { name "move_focus_or_tab"; payload "right"; move_mod "alt"; use_arrow_keys "false"; floating true; };
        }
        bind "Alt Shift h" { MovePane "Left"; }
        bind "Alt Shift j" { MovePane "Down"; }
        bind "Alt Shift k" { MovePane "Up"; }
        bind "Alt Shift l" { MovePane "Right"; }

        // Panes
        bind "Alt n" { NewPane; }
        bind "Alt Shift n" { NewPane "Down"; }
        bind "Alt x" { CloseFocus; }
        bind "Alt Shift x" { CloseTab; }
        bind "Alt f" { ToggleFloatingPanes; }
        bind "Alt Shift f" { TogglePaneEmbedOrFloating; }
        bind "Alt z" { ToggleFocusFullscreen; }
        bind "Alt p" { TogglePaneInGroup; }
        bind "Alt Shift p" { ToggleGroupMarking; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }

        // Tabs
        bind "Alt t" { NewTab; }
        bind "Alt r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        // Session name asked in a one-row floating pane
        bind "Alt Shift r" {
            Run "bash" "-c" r#"read -r n && [ -n "$n" ] && zellij action rename-session "$n""# {
                floating true; close_on_exit true; name "Rename Session";
                width "40"; height "3"; x "30%"; y "40%";
            };
        }
        bind "Alt [" { GoToPreviousTab; }
        bind "Alt ]" { GoToNextTab; }
        bind "Alt Shift [" "Alt {" { MoveTab "Left"; }
        bind "Alt Shift ]" "Alt }" { MoveTab "Right"; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }

        // Layout, sessions, help
        bind "Alt Space" { NextSwapLayout; }
        bind "Alt o" { LaunchOrFocusPlugin "sessionizer" { floating true; move_to_focused_tab true; }; }
        bind "Alt Shift o" { LaunchOrFocusPlugin "zellij:session-manager" { floating true; move_to_focused_tab true; }; }
        bind "Alt /" "Alt ?" { LaunchOrFocusPlugin "forgot" { floating true; }; }
    }
    shared_except "locked" {
        bind "Ctrl g" { SwitchToMode "Locked"; }
        bind "Ctrl q" { Quit; }
    }
    shared_except "locked" "entersearch" "renametab" "renamepane" {
        bind "Enter" "Esc" { SwitchToMode "Locked"; }
    }
}

#!/usr/bin/env bash

# Create a `bat` command on systems where Debian/Ubuntu provide it as `batcat`.

set -o errexit
set -o nounset
set -o pipefail

readonly target_dir="${HOME}/.local/bin"
readonly target="${target_dir}/bat"

if command -v bat >/dev/null 2>&1; then
  exit 0
fi

if ! batcat_path="$(command -v batcat 2>/dev/null)"; then
  printf '%s\n' "batcat not found" >&2
  exit 1
fi

if [[ -e "$target" && ! -L "$target" ]]; then
  printf '%s\n' "$target already exists and is not a symlink" >&2
  exit 1
fi

mkdir -p "$target_dir"
ln -sfn "$batcat_path" "$target"

printf 'Linked %s -> %s\n' "$target" "$batcat_path"

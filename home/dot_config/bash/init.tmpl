{{- $mise := lookPath "mise" -}}
{{- if and (not $mise) (stat (joinPath .chezmoi.homeDir ".local/bin/mise")) -}}
{{-   $mise = joinPath .chezmoi.homeDir ".local/bin/mise" -}}
{{- end -}}
{{- if $mise -}}
{{- $activate := output $mise "activate" "bash" | regexFind "(?s)export __MISE_EXE=.*" | replace "\n_mise_hook\n" "\n" -}}
{{ $activate | trim }}
{{ end -}}

{{- if lookPath "zoxide" }}
{{ output "zoxide" "init" "bash" | trim }}
{{ end -}}

{{- if lookPath "fzf" }}
{{ output "fzf" "--bash" | splitList "### completion.bash ###" | first | trim }}
{{ end -}}

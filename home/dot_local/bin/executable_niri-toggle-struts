#!/usr/bin/env bash
# Toggle a focus layout: wider niri struts and hidden DMS bar.
# Pressing it again empties the override and restores the struts from layout.kdl.
set -euo pipefail

override="${XDG_CONFIG_HOME:-$HOME/.config}/niri/config/struts.kdl"

if [[ -s $override ]]; then
    : >"$override"
    dms ipc call bar reveal index 0 >/dev/null
else
    cat >"$override" <<'KDL'
layout {
    struts {
        left 50
        right 50
        top 50
        bottom 50
    }
}
KDL
    dms ipc call bar hide index 0 >/dev/null
fi

niri msg action load-config-file

if [[ ! -s $override ]]; then
    col=$(niri msg -j focused-window | jq -r '.layout.pos_in_scrolling_layout[0] // empty')
    if [[ -n $col ]]; then
        if ((col == 1)); then
            niri msg action focus-column-last
        else
            niri msg action focus-column-first
        fi
        niri msg action focus-column "$col"
    fi
fi

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 3,
      "left": 4,
      "right": 8,
    },
    "color": {
      "1": "blue",
      "2": "cyan",
      "3": "green",
      "4": "yellow",
    },
  },
  "display": {
    "bar": {
      "char": {
        "total": "─",
        "elapsed": "▰",
        "empty": "▱",
      },
      "width": 10,
    },
    "percent": {
      "type": 3,
      "ndigits": 0,
    },
    "key": {
      "width": 4,
    },
    "separator": " ",
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": "",
      "keyColor": "blue",
      "format": "{#36}{1}@{2}",
    },
    {
      "type": "command",
      "key": "󱦟",
      "keyColor": "blue",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days",
    },
    {
      "type": "uptime",
      "key": "󱫐",
      "keyColor": "blue",
    },
    "break",
    {
      "type": "kernel",
      "key": "",
      "keyColor": "blue",
    },
    {
      "type": "command",
      "key": "",
      "keyColor": "blue",
      "text": "ff='fastfetch -c none --pipe -l none --key-type none'; de=$($ff -s de 2>/dev/null); wm=$($ff -s wm 2>/dev/null); if [ -n \"$de\" ]; then echo \"$de${wm:+ · $wm}\"; else echo \"$wm\"; fi",
    },
    {
      "type": "command",
      "key": "󰸌",
      "keyColor": "cyan",
      "text": "echo \"Rose Pine Dawn \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\"",
    },
    "break",
    {
      "type": "disk",
      "key": "󰋊",
      "keyColor": "cyan",
      "format": "{1} / {2} ({3})",
    },
    {
      "type": "swap",
      "key": "󰓡",
      "keyColor": "green",
      "format": "{used} / {total} ({percentage})",
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "green",
    },
    "break",
    {
      "type": "host",
      "key": "",
      "keyColor": "yellow",
    },
    {
      "type": "cpu",
      "key": "",
      "keyColor": "yellow",
    },
    {
      "type": "gpu",
      "key": "",
      "detectionMethod": "pci",
      "keyColor": "yellow",
    },
    "break",
  ],
}

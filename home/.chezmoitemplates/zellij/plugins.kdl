{{- $plugins := printf "file:%s/.config/zellij/plugins" .chezmoi.homeDir -}}
plugins {
    tab-bar { path "tab-bar"; }
    status-bar { path "status-bar"; }
    strider { path "strider"; }
    compact-bar { path "compact-bar"; }

    // Minimal status bar. Colors are ANSI names, so they follow the terminal
    // palette (rose-pine / rose-pine-dawn) instead of being hardcoded.
    zjstatus location="{{ $plugins }}/zjstatus.wasm" {
        format_left   " {mode}  {tabs}"
        format_center ""
        format_right  "#[fg=cyan]{{ .chezmoi.username }}@{{ .chezmoi.hostname }} #[fg=bright_black][{session}] "
        format_space  ""
        format_hide_on_overlength "true"
        format_precedence "lrc"

        border_enabled  "true"
        border_char     "─"
        border_format   "#[fg=black]{char}"
        border_position "bottom"

        tab_normal    "#[fg=black]#[fg=white,bg=black] {name}{fullscreen_indicator}{floating_indicator} #[fg=black]"
        tab_active    "#[fg=magenta]#[fg=black,bg=magenta,bold] {name}{fullscreen_indicator}{floating_indicator} #[fg=magenta]"
        tab_separator " "
        tab_fullscreen_indicator " □"
        tab_floating_indicator   " 󰉈"

        mode_locked       "#[fg=blue,bold]LOCKED"
        mode_normal       "#[fg=green,bold]NORMAL"
        mode_pane         "#[fg=magenta,bold]PANE"
        mode_resize       "#[fg=red,bold]RESIZE"
        mode_scroll       "#[fg=yellow,bold]SCROLL"
        mode_enter_search "#[fg=green,bold]SEARCH"
        mode_search       "#[fg=green,bold]SEARCH"
        mode_rename_tab   "#[fg=cyan,bold]RENAME"
        mode_rename_pane  "#[fg=magenta,bold]RENAME"
        mode_session      "#[fg=blue,bold]SESSION"
    }

    // Alt hjkl across zellij panes and neovim splits
    vim-nav location="{{ $plugins }}/vim-zellij-navigator.wasm"

    // Searchable list of the configured keybinds
    forgot location="{{ $plugins }}/zellij-forgot.wasm"

    // Session per project dir: attaches if it exists, otherwise creates it with the default layout
    sessionizer location="{{ $plugins }}/zellij-sessionizer.wasm" {
        cwd "/"
        root_dirs "{{ .chezmoi.homeDir }}/Work/projects"
        individual_dirs "{{ .chezmoi.homeDir }}/.local/share/chezmoi"
        session_layout "{{ .chezmoi.homeDir }}/.config/zellij/layouts/default.kdl"
    }
}

.config/git/config-local*
.bashrc.local
.config/niri/config/outputs.kdl
.config/niri/config/struts.kdl
.config/niri/dms/outputs.kdl

{{ if not (lookPath "batcat") }}
.local/bin/bat
{{ end }}

{{ if not (lookPath "niri") }}
.config/niri
{{ else if not (lookPath "dms") }}
.config/niri/dms
{{ end }}

{{ if not (lookPath "dms") }}
.config/dms
.local/bin/niri-toggle-struts
.local/state/dms
{{ end }}

{{ if not (lookPath "bitwarden") }}
.config/systemd/user/bitwarden-ssh-auth-sock.service
.config/systemd/user/default.target.wants/bitwarden-ssh-auth-sock.service
.config/autostart/bitwarden-launcher.desktop
{{ end }}

{{ if not (lookPath "claude") }}
.claude
{{ end }}

{{- $name := promptStringOnce . "git.name" "Git name" "Luca Pattocchio" -}}
{{- $email := promptStringOnce . "git.email" "Default Git email" -}}
{{- $useBitwarden := promptBoolOnce . "bitwarden.enabled" "Use Bitwarden for secrets (GPG keys)" false -}}

[data.git]
    name = {{ $name | quote }}
    email = {{ $email | quote }}

[data.bitwarden]
    enabled = {{ $useBitwarden }}

# SSH key management
ssh-keyput() {
  if (( $# < 1 || $# > 2 )); then
    echo "Usage: ssh-keyput <user@host> [path_to_key (default: ~/.ssh/id_ed25519.pub)]"
    return 1
  fi

  ssh-copy-id -i "${2:-$HOME/.ssh/id_ed25519.pub}" "$1"
}

# Copy a file picked with fzf, newest first, to an scp destination
if command -v fzf &> /dev/null; then
  sff() {
    if (( $# == 0 )); then
      echo "Usage: sff <destination> (e.g. sff host:/tmp/)"
      return 1
    fi

    local file
    file=$(find . -type f -printf '%T@\t%p\n' | sort -rn | cut -f2- | ff) && [[ -n $file ]] && scp "$file" "$1"
  }
fi
